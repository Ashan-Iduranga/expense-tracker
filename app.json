{
  "expo": {
    "name": "Daily Strip",
    "slug": "expense-tracker",
    "owner": "ashan_iduranga",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon/icon.png",
      "bundleIdentifier": "com.ashaniduranga.dailystrip"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/foreground.png",
        "monochromeImage": "./assets/icon/monochrome.png",
        "backgroundColor": "#C6F432"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ashaniduranga.dailystrip",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F0C",
          "image": "./assets/icon/splash.png",
          "imageWidth": 150
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#C6F432",
          "enableRemoteNotifications": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "363e0db4-a4c9-4e18-9f55-4822db41720d"
      }
    }
  }
}
